---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import SignalCore from '../../../components/SignalCore.astro';
---
<Base title="How this portfolio is built — Emmanuel Guevara Vásquez" path="/projects/portfolio/"><Header/><main id="main" class="build-notes shell"><a class="text-link" href="/"><Icon name="arrow" class="back-arrow"/><span data-i18n="back">Back to the playground</span></a><h1 data-i18n="notesTitle">A playground with a purpose.</h1><p class="notes-intro" data-i18n="notesIntro">An independent, static portfolio built to explore software, visual systems and thoughtful interactions.</p><div class="notes-grid"><div>{[['notesArchitecture','Small by design.','notesArchitectureText','Astro renders the content to static HTML. TypeScript handles the terminal, language switch and calendar filters. Tailwind and custom CSS share a single set of design tokens. No React runtime, backend or visitor-facing API requests are required.'],['notesData','Real signals. Clear boundaries.','notesDataText','GitHub activity comes from an unauthenticated public snapshot with a visible capture date. A scheduled workflow can refresh it. If a refresh fails, the previous verified snapshot remains dated. Private project implementations stay private.'],['notesMotion','Motion with restraint.','notesMotionText','Vector orbits, a scan line and a small pixel satellite add personality. Reduced-motion preferences stop the animation. The terminal only understands a fixed list of portfolio commands and never executes system commands.'],['notesDeployment','Ready for a static home.','notesDeploymentText','The build targets GitHub Pages at gvemmanuel3712-cyber.github.io. Content, typography and scripts are bundled locally. No paid backend or visitor account is required, and all core content is available without JavaScript.']].map(([headingKey,heading,textKey,text])=><section><h2 data-i18n={headingKey}>{heading}</h2><p data-i18n={textKey}>{text}</p></section>)}</div><aside class="notes-aside panel"><SignalCore id="notes-core"/><ul class="tech-inline"><li>Astro</li><li>TypeScript</li><li>Tailwind CSS</li></ul><p class="mono">HTML first.<br/>Small scripts.<br/>Public data.<br/>Private boundaries.</p><a class="text-link" href="https://github.com/gvemmanuel3712-cyber/gvemmanuel3712-cyber.github.io" target="_blank" rel="noopener noreferrer"><span data-i18n="source">Source</span><Icon name="external" size={17}/></a></aside></div></main><Footer/></Base>
