---
const rows = ['1100000000000011','1110000000000111','0111000110001110','0011101111011100','0001111111111000','0000111111110000','0000011111100000','0000111111110000','0001111111111000','0011101111011100','0111000110001110','1110000000000111','1100000000000011'];
---
<svg class="pixel-satellite" width="58" height="52" viewBox="0 0 64 56" fill="currentColor" aria-hidden="true" shape-rendering="crispEdges">
  {rows.flatMap((row,y)=>[...row].map((cell,x)=>cell==='1'&&<rect x={x*4} y={y*4} width="3" height="3" opacity={x>4&&x<11?1:.65}/>))}
</svg>
